# ============================================================
#  IRManager — .gitattributes
#  Normaliza los finales de línea: LF en repositorio,
#  conversión automática en checkout según el SO del cliente.
# ============================================================

# Por defecto, todos los ficheros de texto usan LF
* text=auto eol=lf

# Ficheros que siempre deben ser LF (código fuente embebido)
*.cpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Ficheros binarios — sin conversión
*.bin   binary
*.elf   binary
*.a     binary
*.o     binary
