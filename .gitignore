# ============================================================
#  IRManager — .gitignore
# ============================================================

# PlatformIO build output
.pio/

# Binarios compilados
*.bin
*.elf
*.map

# VSCode local (extensiones sí se commitean, settings no)
.vscode/settings.json
.vscode/launch.json
.vscode/ipch/

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales de Python
__pycache__/
*.pyc

# Credenciales y configuración local (nunca commitear)
credentials.h
secrets.h
